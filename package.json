{
  "name": "myblog-vue3",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "blog": "node src/scripts/blog-cli.js",
    "dev": "node src/scripts/blog-cli.js server",
    "preinstall": "yarn config set registry https://registry.npmjs.org/",
    "prebuild": "node src/scripts/generate-metadata.js",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite-ssg build",
    "type-check": "vue-tsc --build --force",
    "generate": "node src/scripts/blog-cli.js generate",
    "server": "node src/scripts/blog-cli.js server",
    "new": "node src/scripts/blog-cli.js new",
    "newp": "node src/scripts/blog-cli.js new",
    "upload-images": "scripts/.venv/bin/python scripts/upload_markdown_images_to_cos.py"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.80",
    "@ai-sdk/openai-compatible": "^2.0.48",
    "@css-render/vue3-ssr": "^0.15.14",
    "@vercel/analytics": "^1.3.1",
    "@vercel/speed-insights": "^1.0.12",
    "ai": "^6.0.193",
    "axios": "^1.7.5",
    "front-matter": "^4.0.2",
    "katex": "^0.16.22",
    "markdown-it": "^14.1.0",
    "markdown-it-texmath": "^1.0.0",
    "pinia": "^2.2.2",
    "vue": "^3.4.38",
    "vue-router": "^4.4.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tsconfig/node20": "^20.1.4",
    "@types/node": "^22.5.0",
    "@vicons/ionicons5": "^0.12.0",
    "@vitejs/plugin-vue": "^5.1.2",
    "@vue/tsconfig": "^0.5.1",
    "naive-ui": "^2.39.0",
    "npm-run-all2": "^6.2.2",
    "typescript": "~5.5.4",
    "vfonts": "^0.0.3",
    "vite": "^5.4.2",
    "vite-ssg": "^0.23.8",
    "vue-tsc": "^2.0.29"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
